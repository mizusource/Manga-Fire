<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- الثيم الأساسي الفاخر للتطبيق (الوضع الليلي) -->
    <style name="Theme.Animeista.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/deep_sky_blue_500</item>
        <item name="colorPrimaryVariant">@color/deep_sky_blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/atomic_tangerine</item>
        <item name="colorSecondaryVariant">@color/atomic_tangerine_700</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <item name="android:colorBackground">@color/black_pearl_700</item>
        <item name="colorOnBackground">@color/white_dim</item>
        
        <item name="colorSurface">@color/black_pearl_500</item>
        <item name="colorOnSurface">@color/cloud_blue</item>
        
        <!-- 🚀 الألوان الناقصة التي كانت تسبب الكراش -->
        <item name="colorSurfaceVariant">@color/black_pearl_300</item>
        <item name="colorOnSurfaceVariant">@color/gray_500</item>
        <item name="colorOutline">@color/gray_300</item>
        
        <item name="colorError">@color/red</item>
        <item name="colorOnError">@color/black</item>
        
        <item name="android:statusBarColor">@color/black_pearl_700</item>
        <item name="android:navigationBarColor">@color/black_pearl_700</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <item name="colorControlHighlight">@color/black_pearl_300</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <!-- ثيم شاشة البداية (Splash Screen) -->
    <style name="Theme.MangaFire.Splash" parent="Theme.Animeista.Dark">
        <item name="android:windowBackground">@color/black_pearl_700</item>
        <item name="android:statusBarColor">@color/black_pearl_700</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <style name="WindowAnimationTransition">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>
    <!-- Dark Neon Themes -->
    <style name="Theme.Animeista.DarkNeonRed" parent="Theme.Animeista.Dark">
        <item name="colorPrimary">@color/dn_red_primary</item>
        <item name="colorSecondary">@color/dn_red_primary</item>
        <item name="android:colorBackground">@color/dn_red_background</item>
        <item name="colorSurface">@color/dn_red_surface</item>
        <item name="android:statusBarColor">@color/dn_red_background</item>
        <item name="android:navigationBarColor">@color/dn_red_background</item>
    </style>
    <style name="Theme.Animeista.DarkNeonPurple" parent="Theme.Animeista.Dark">
        <item name="colorPrimary">@color/dn_purple_primary</item>
        <item name="colorSecondary">@color/dn_purple_primary</item>
        <item name="android:colorBackground">@color/dn_purple_background</item>
        <item name="colorSurface">@color/dn_purple_surface</item>
        <item name="android:statusBarColor">@color/dn_purple_background</item>
        <item name="android:navigationBarColor">@color/dn_purple_background</item>
    </style>
    <style name="Theme.Animeista.DarkNeonYellow" parent="Theme.Animeista.Dark">
        <item name="colorPrimary">@color/dn_yellow_primary</item>
        <item name="colorSecondary">@color/dn_yellow_primary</item>
        <item name="android:colorBackground">@color/dn_yellow_background</item>
        <item name="colorSurface">@color/dn_yellow_surface</item>
        <item name="android:statusBarColor">@color/dn_yellow_background</item>
        <item name="android:navigationBarColor">@color/dn_yellow_background</item>
    </style>

    <!-- Classic Light Themes -->
    <style name="Theme.Animeista.ClassicWhite" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cl_white_primary</item>
        <item name="colorSecondary">@color/cl_white_primary</item>
        <item name="android:colorBackground">@color/cl_white_background</item>
        <item name="colorSurface">@color/cl_white_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnBackground">@color/cl_white_text</item>
        <item name="colorOnSurface">@color/cl_white_text</item>
        <item name="colorOnSurfaceVariant">@color/material_grey_600</item>
        <item name="android:statusBarColor">@color/cl_white_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cl_white_background</item>
    </style>
    <style name="Theme.Animeista.ClassicRed" parent="Theme.Animeista.ClassicWhite">
        <item name="colorPrimary">@color/cl_red_primary</item>
        <item name="colorSecondary">@color/cl_red_primary</item>
    </style>
    <style name="Theme.Animeista.ClassicBlue" parent="Theme.Animeista.ClassicWhite">
        <item name="colorPrimary">@color/cl_blue_primary</item>
        <item name="colorSecondary">@color/cl_blue_primary</item>
    </style>
    <style name="Theme.Animeista.ClassicPurple" parent="Theme.Animeista.ClassicWhite">
        <item name="colorPrimary">@color/cl_purple_primary</item>
        <item name="colorSecondary">@color/cl_purple_primary</item>
    </style>

    <!-- Classic Dark Theme -->
    <style name="Theme.Animeista.ClassicNavy" parent="Theme.Animeista.Dark">
        <item name="colorPrimary">@color/cl_navy_primary</item>
        <item name="colorSecondary">@color/cl_navy_primary</item>
        <item name="android:colorBackground">@color/cl_navy_background</item>
        <item name="colorSurface">@color/cl_navy_surface</item>
        <item name="colorOnBackground">@color/cl_navy_text</item>
        <item name="colorOnSurface">@color/cl_navy_text</item>
        <item name="android:statusBarColor">@color/cl_navy_background</item>
        <item name="android:navigationBarColor">@color/cl_navy_background</item>
    </style>
</resources>
