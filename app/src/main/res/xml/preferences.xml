<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/appearance">
        <ListPreference
            android:key="app_theme"
            android:title="@string/theme"
            android:summary="@string/theme_summary"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:defaultValue="dark_neon_blue" />
        <ListPreference
            android:key="language"
            android:title="@string/language"
            android:summary="@string/language_summary"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:defaultValue="ar" />
    </PreferenceCategory>
    <PreferenceCategory android:title="التخزين والتحميلات">
        <Preference
            android:key="storage_manager"
            android:title="إدارة التخزين الذكية"
            android:summary="التحكم في الفصول المحملة والمؤقتة لتوفير المساحة"
            android:icon="@android:drawable/ic_menu_manage" />
        <ListPreference
            android:key="download_quality"
            android:title="جودة التنزيل الافتراضية"
            android:summary="اختر جودة الصور عند تحميل الفصول"
            android:entries="@array/download_quality_entries"
            android:entryValues="@array/download_quality_values"
            android:defaultValue="HIGH" />
        <SwitchPreferenceCompat
            android:key="wifi_only"
            android:title="@string/wifi_only"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="النسخ الاحتياطي والمزامنة">
        <Preference
            android:key="backup_export"
            android:title="تصدير نسخة احتياطية"
            android:summary="حفظ المفضلة وسجل القراءة لملف محلي" />
        <Preference
            android:key="backup_import"
            android:title="استيراد نسخة احتياطية"
            android:summary="استرجاع البيانات من ملف سابق" />
    </PreferenceCategory>
    <PreferenceCategory android:title="تواصل معنا">
        <Preference
            android:key="telegram_channel"
            android:title="قناتنا على تليجرام"
            android:summary="انضم ليصلك كل جديد" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/maintenance">
        <Preference
            android:key="clear_cache"
            android:title="@string/clear_cache"
            android:summary="@string/clear_cache_summary" />
        <Preference
            android:key="clear_downloads"
            android:title="@string/clear_downloads"
            android:summary="@string/clear_downloads_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="الإشعارات">
        <SwitchPreferenceCompat
            android:key="notifications_enabled"
            android:title="إشعارات الفصول الجديدة"
            android:summary="تلقي تنبيهات عند نزول فصول جديدة للمانجا المفضلة"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/account">
        <Preference
            android:key="logout"
            android:title="@string/logout"
            android:summary="@string/logout_summary" />
    </PreferenceCategory>
</PreferenceScreen>
