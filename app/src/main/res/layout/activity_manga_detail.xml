<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:layoutDirection="rtl">

    <!-- Blurred Background Image spanning top -->
    <ImageView
        android:id="@+id/mangaCoverBlur"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:scaleType="centerCrop"
        android:alpha="0.6" />
        
    <View
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:background="@drawable/bg_gradient_transparent_to_dark" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="90dp"> <!-- Space for floating toolbar -->
                    
                    <!-- Glassmorphic Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/bg_glassmorphism"
                        android:padding="16dp"
                        android:orientation="horizontal">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="110dp"
                            android:layout_height="150dp"
                            app:cardCornerRadius="12dp">
                            <ImageView
                                android:id="@+id/mangaCover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />
                        </androidx.cardview.widget.CardView>
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/mangaTitleDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:maxLines="3"
                                android:ellipsize="end" />
                            <TextView
                                android:id="@+id/mangaAuthor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="المؤلف"
                                android:textColor="#B3FFFFFF"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/mangaStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="مستمرة"
                                android:textColor="#B3FFFFFF"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                    
                    <!-- Start Reading Button -->
                    <Button
                        android:id="@+id/btnStartReading"
                        android:layout_width="220dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_button_glow"
                        android:text="إقرأ الآن"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        app:backgroundTint="@null" />
                        
                    <!-- Tabs -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="#00000000"
                        app:tabIndicatorColor="#39FF14"
                        app:tabSelectedTextColor="#39FF14"
                        app:tabTextColor="#B3FFFFFF"
                        app:tabIndicatorHeight="3dp">
                        <com.google.android.material.tabs.TabItem android:text="التفاصيل" />
                        <com.google.android.material.tabs.TabItem android:text="الفصول" />
                    </com.google.android.material.tabs.TabLayout>
                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#33FFFFFF" />
                    
                    <!-- Content area -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        
                        <!-- Details Tab -->
                        <LinearLayout
                            android:id="@+id/detailsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            
                            <!-- Stats Row (Glassmorphic) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="20dp"
                                android:background="@drawable/bg_glassmorphism"
                                android:padding="16dp"
                                android:orientation="horizontal"
                                android:weightSum="2">
                                
                                <!-- User Rating -->
                                <LinearLayout
                                    android:id="@+id/btnUserRating"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">
                                        <ImageView
                                            android:id="@+id/ivUserRatingStar"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/ic_star"
                                            app:tint="#FFB300" />
                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/ic_star"
                                            app:tint="#FFB300" />
                                        <TextView
                                            android:id="@+id/tvGlobalRating"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="9.6/10"
                                            android:textColor="#FFFFFF"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                    <TextView
                                        android:id="@+id/tvGlobalRatingCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="3673 Ratings"
                                        android:textColor="#B3FFFFFF"
                                        android:textSize="12sp" />
                                </LinearLayout>
                                
                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="#33FFFFFF" />
                                
                                <!-- AL Rating -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">
                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/ic_language"
                                            app:tint="#64B5F6" />
                                        <TextView
                                            android:id="@+id/tvALRating"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:text="8.2/10"
                                            android:textColor="#FFFFFF"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                    <TextView
                                        android:id="@+id/tvALRatingCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="19k"
                                        android:textColor="#B3FFFFFF"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                            
                            <!-- Tags Horizontal Scroll -->
                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:paddingHorizontal="20dp"
                                android:scrollbars="none"
                                android:clipToPadding="false">
                                <LinearLayout
                                    android:id="@+id/tagsContainer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    
                                    <TextView
                                        android:id="@+id/tvTagAction"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_glassmorphism"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="8dp"
                                        android:text="🗡 Action"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp" />
                                        
                                    <TextView
                                        android:id="@+id/tvTagManga"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:background="@drawable/bg_glassmorphism"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="8dp"
                                        android:text="📖 Manga"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp" />
                                        
                                    <TextView
                                        android:id="@+id/tvAniListCountry"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:background="@drawable/bg_glassmorphism"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="8dp"
                                        android:text="🌐 JP"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp" />
                                        
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:background="@drawable/bg_glassmorphism"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="8dp"
                                        android:text="Adventure"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp" />
                                        
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:background="@drawable/bg_glassmorphism"
                                        android:paddingHorizontal="16dp"
                                        android:paddingVertical="8dp"
                                        android:text="Fantasy"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp" />
                                        
                                </LinearLayout>
                            </HorizontalScrollView>
                            
                            <!-- Description -->
                            <TextView
                                android:id="@+id/mangaDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                android:paddingHorizontal="24dp"
                                android:paddingBottom="40dp"
                                android:lineSpacingExtra="8dp"
                                android:textColor="#E0E0E0"
                                android:textSize="15sp" />
                                
                        </LinearLayout>
                        
                        <!-- Chapters Tab -->
                        
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/chaptersRecyclerView"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingBottom="100dp"
                                android:clipToPadding="false"
                                android:nestedScrollingEnabled="false" />
                        
                        
                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="50dp"
                            android:indeterminateTint="#39FF14"
                            android:visibility="gone" />
                            
                    </FrameLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    
    <!-- Floating Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="10dp"
            android:src="@drawable/ic_back_arrow"
            android:background="@drawable/bg_glass_icon"
            app:tint="#FFFFFF" />
            
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">
            
            <ImageView
                android:id="@+id/btnDownloadMultiple"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_drawer_download"
                android:background="@drawable/bg_glass_icon"
                app:tint="#FFFFFF" />
                
            <ImageView
                android:id="@+id/btnComments"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:padding="10dp"
                android:src="@drawable/ic_comments"
                android:background="@drawable/bg_glass_icon"
                app:tint="#FFFFFF" />
                
            <!-- Using FrameLayout for Favorite to keep the same ID for the click listener if it was on a container before, but btnFavorite is usually what's clicked -->
            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:padding="10dp"
                android:src="@drawable/ic_favorite_border"
                android:background="@drawable/bg_glass_icon"
                app:tint="#FFFFFF" />
                
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
