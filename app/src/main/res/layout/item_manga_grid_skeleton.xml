<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Skeleton Cover -->
        <View
            android:id="@+id/skeletonCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#E0E0E0"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Gradient Overlay -->
        <View
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_gradient_bottom"
            app:layout_constraintBottom_toBottomOf="@id/skeletonCover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Skeleton Title -->
        <View
            android:id="@+id/skeletonTitle"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="#D6D6D6"
            app:layout_constraintBottom_toTopOf="@+id/skeletonChapter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Skeleton Chapter -->
        <View
            android:id="@+id/skeletonChapter"
            android:layout_width="60dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:background="#D6D6D6"
            app:layout_constraintBottom_toBottomOf="@id/skeletonCover"
            app:layout_constraintStart_toStartOf="parent"/>
            
        <!-- Skeleton Rating -->
        <View
            android:id="@+id/skeletonRating"
            android:layout_width="30dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="#D6D6D6"
            app:layout_constraintBottom_toBottomOf="@id/skeletonCover"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
