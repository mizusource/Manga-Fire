<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceVariant"
    android:elevation="12dp"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <!-- Reply/Metadata above -->
    <LinearLayout
        android:id="@+id/layoutReplyMetadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvReplyTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الرد على @mostafa"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical|bottom">
        
        <!-- Options toggle / Attach -->
        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_add"
            app:tint="?attr/colorOnSurfaceVariant"
            android:layout_marginEnd="4dp" />

        <!-- Input Box container (ViewFlipper for state changes if needed) -->
        <ViewFlipper
            android:id="@+id/viewFlipperInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_input_bg"
            android:padding="2dp">
            
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCommentInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:maxHeight="120dp"
                android:background="@null"
                android:hint="أضف تعليقاً..."
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:inputType="textMultiLine|textCapSentences"
                android:scrollbars="vertical" />
                
        </ViewFlipper>

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/btnSendComment"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_bg_purple"
            android:src="@android:drawable/ic_menu_send"
            android:padding="10dp"
            app:tint="@android:color/white" />
            
    </LinearLayout>
    
    <CheckBox
        android:id="@+id/cbSpoiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:text="حرق 🚨"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:padding="0dp"
        android:minHeight="0dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

</LinearLayout>
